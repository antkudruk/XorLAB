{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "xorlab: test collection",
      "type": "shell",
      "command": "npm run test:collection",
      "options": {
        "cwd": "${workspaceFolder}/xorlab"
      },
      "group": "test",
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      },
      "problemMatcher": []
    },
    {
      "label": "xorlab: test current file",
      "type": "shell",
      "command": "npm run test -- --runTestsByPath \"${file}\"",
      "options": {
        "cwd": "${workspaceFolder}/xorlab"
      },
      "group": "test",
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      },
      "problemMatcher": []
    }
  ]
}
